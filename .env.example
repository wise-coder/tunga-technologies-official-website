# Set the confirmed production origin, with no trailing slash.
NEXT_PUBLIC_SITE_URL=
# Opt in only on the production deployment. Staging remains noindex.
SITE_INDEXABLE=false
# Display only confirmed company channels; empty entries are hidden.
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_LINKEDIN_URL=
COMPANY_GITHUB_URL=
# Server-only HTTPS webhook: POST JSON, accepts enquiry only after 2xx response.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Complete src/content/legal.ts, then set this to true to enable delivery.
LEGAL_APPROVED=false
PRIVACY_CONTACT_EMAIL=
ENQUIRY_RETENTION=
