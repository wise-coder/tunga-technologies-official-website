# Set the confirmed production origin, with no trailing slash.
NEXT_PUBLIC_SITE_URL=
# Opt in only on the production deployment. Staging remains noindex.
SITE_INDEXABLE=false
# Display only confirmed company channels; empty entries are hidden.
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_LINKEDIN_URL=
COMPANY_GITHUB_URL=
# Server-only email delivery. Gmail defaults; use 587 for STARTTLS if required.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=serge.wiseabijuru5@gmail.com
SMTP_APP_PASSWORD=
# One receiving mailbox; defaults to SMTP_USER when empty.
CONTACT_TO_EMAIL=serge.wiseabijuru5@gmail.com
# Optional alternative to SMTP. Not needed when email is configured.
# SMTP takes priority; failed SMTP delivery does not retry through the webhook.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Complete src/content/legal.ts, then set this to true to enable delivery.
LEGAL_APPROVED=false
PRIVACY_CONTACT_EMAIL=serge.wiseabijuru5@gmail.com
ENQUIRY_RETENTION="Client enquiries are kept for one week after receipt, then deleted from our enquiry mailbox."
